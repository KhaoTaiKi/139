<script>
  // Initialize Lucide icons
  if (window.lucide) {
    lucide.createIcons();
  }

  // AI prompt synthesis simulation
  function simulateAI() {
    const input = document.getElementById('ai-prompt-input');
    const output = document.getElementById('ai-output');
    if (!input || !output) return;
    const val = input.value.trim();

    if (!val) return;

    output.innerHTML = `
      <div class="text-orange-400 font-semibold flex items-center gap-1.5 animate-pulse">
        <i data-lucide="sparkles" class="w-3.5 h-3.5"></i> Synthesizing prompt: "${val}"...
      </div>
    `;
    if (window.lucide) lucide.createIcons();

    setTimeout(() => {
      output.innerHTML = `
        <div class="text-orange-400 font-semibold flex items-center gap-1.5">
          <i data-lucide="check" class="w-3.5 h-3.5"></i> Generated 3 Action Items for "${val}":
        </div>
        <div class="text-zinc-300">1. [x] Auto-generated Task Entity & Migration schema</div>
        <div class="text-zinc-300">2. [x] Bound Strong Parameters in <code>TasksController</code></div>
        <div class="text-zinc-300">3. [ ] Scheduled integration tests in GitHub Actions</div>
      `;
      if (window.lucide) lucide.createIcons();
    }, 700);
  }
</script>
