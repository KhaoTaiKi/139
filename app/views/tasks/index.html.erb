<% content_for :title, "Doearly Tasks — Rails 8 Hotwire Task Management" %>

<% content_for :head do %>
  <!-- Google Fonts & Tailwind CDN -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
<% end %>

<div class="min-h-screen bg-[#0B0B0C] text-[#F4F4F5] font-sans relative antialiased selection:bg-orange-500/20 selection:text-white flex flex-col justify-between">
  
  <!-- Ambient Glow -->
  <div class="absolute top-0 left-0 right-0 h-[500px] hero-glow pointer-events-none z-0"></div>

  <!-- Header / Navbar -->
  <%= render "shared/navbar" %>

  <!-- Pure Task Manager Workspace -->
  <main class="max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 z-10 relative flex-1 flex flex-col justify-center">
    <%= render "tasks/workspace" %>
  </main>

  <!-- Modal Target Container (Turbo Frame) -->
  <%= turbo_frame_tag "modal" %>

  <!-- Footer -->
  <%= render "shared/footer" %>

</div>
