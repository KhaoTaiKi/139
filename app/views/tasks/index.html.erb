<% content_for :title, "Doearly — Work Smarter With AI Task Management" %>

<% content_for :head do %>
  <!-- Google Fonts & Tailwind CDN -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            brand: {
              bg: '#0B0B0C',
              surface: '#161618',
              surfaceHover: '#1C1C1F',
              border: '#27272A',
              borderLight: '#3F3F46',
              text: '#F4F4F5',
              muted: '#8E8E93',
              subtle: '#71717A',
              accent: '#F97316',
              accentHover: '#EA580C',
            }
          },
          letterSpacing: {
            tightest: '-0.04em',
            tighter: '-0.03em',
          }
        }
      }
    }
  </script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    body {
      background-color: #0B0B0C !important;
      color: #F4F4F5 !important;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }
    
    ::selection {
      background: rgba(249, 115, 22, 0.25);
      color: #F4F4F5;
    }

    .hero-glow {
      background: radial-gradient(circle 600px at 50% -10%, rgba(249, 115, 22, 0.12), rgba(59, 130, 246, 0.04), transparent 70%);
    }

    .ambient-card-glow {
      background: radial-gradient(circle at 50% 0%, rgba(249, 115, 22, 0.08), transparent 70%);
    }

    .glass-nav {
      background: rgba(11, 11, 12, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .glass-card {
      background: #161618;
      border: 1px solid #27272A;
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.5);
    }

    .glass-card:hover {
      border-color: #3F3F46;
      box-shadow: 0 8px 30px -4px rgba(0, 0, 0, 0.7), 0 0 15px -3px rgba(249, 115, 22, 0.08);
    }
  </style>
<% end %>

<div class="min-h-screen bg-[#0B0B0C] text-[#F4F4F5] font-sans relative antialiased selection:bg-orange-500/20 selection:text-white">
  
  <!-- Ambient Hero Glow -->
  <div class="absolute top-0 left-0 right-0 h-[750px] hero-glow pointer-events-none z-0"></div>

  <!-- 1. Top Announcement Bar -->
  <aside class="relative z-50 bg-[#161618] border-b border-[#27272A] py-2 px-4 text-center text-xs sm:text-sm font-medium text-brand-muted hover:text-brand-text transition-colors">
    <a href="#features" class="inline-flex items-center gap-2 group">
      <span class="inline-block w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span>
      <span>Start using AI to manage your tasks today</span>
      <span class="text-brand-accent group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-200">↗</span>
    </a>
  </aside>

  <!-- 2. Sticky Glassmorphism Navbar -->
  <header class="sticky top-0 z-40 w-full glass-nav border-b border-brand-border/70 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      
      <!-- Brand Logo -->
      <a href="#" class="flex items-center gap-2.5 group">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-accent to-orange-600 flex items-center justify-center text-white shadow-lg shadow-orange-500/20">
          <i data-lucide="layers" class="w-4 h-4"></i>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-lg font-bold tracking-tight text-white">Doearly</span>
          <span class="text-[10px] uppercase font-mono font-bold bg-zinc-800 text-zinc-300 border border-zinc-700 px-1.5 py-0.5 rounded">AI 2.0</span>
        </div>
      </a>

      <!-- Navigation Links -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-brand-muted">
        <a href="#features" class="hover:text-white transition-colors">Features</a>
        <a href="#how-it-works" class="hover:text-white transition-colors">How it Works</a>
        <a href="#bento" class="hover:text-white transition-colors">Workspace</a>
        <a href="#pricing" class="hover:text-white transition-colors">Pricing</a>
        <a href="#faq" class="hover:text-white transition-colors">FAQ</a>
      </nav>

      <!-- CTA Action -->
      <div class="flex items-center gap-3">
        <a href="#mockup" class="hidden sm:inline-flex text-xs font-semibold text-zinc-300 hover:text-white px-3 py-2 transition-colors">
          Sign In
        </a>
        <a href="#get-started" class="inline-flex items-center gap-2 bg-white text-black hover:bg-zinc-200 text-xs sm:text-sm font-semibold px-4 py-2 rounded-lg transition-all duration-200 shadow-sm hover:shadow-white/10">
          <span>Book a Demo</span>
          <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
        </a>
      </div>
    </div>
  </header>

  <main class="flex-grow z-10">

    <!-- 3. Hero Section -->
    <section class="pt-20 pb-16 sm:pt-28 sm:pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center">
      
      <!-- Pill Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#161618] border border-[#27272A] text-xs font-medium text-zinc-300 mb-8 hover:border-zinc-600 transition-colors shadow-sm">
        <span class="text-brand-accent">✨</span>
        <span>AI-Powered Task Management</span>
        <span class="text-zinc-500">|</span>
        <span class="text-zinc-400 font-mono text-[11px]">v2.4 Live</span>
      </div>

      <!-- Main Heading -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-brand-text tracking-tightest leading-[1.08] max-w-4xl mx-auto mb-6">
        Work Smarter With <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-white via-zinc-200 to-zinc-400 bg-clip-text text-transparent">AI Task Management</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg lg:text-xl text-brand-muted max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        Automate routine triage, synthesize sprint backlogs, and achieve effortless team synchronization with real-time generative intelligence.
      </p>

      <!-- Dual CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <a href="#get-started" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white text-black hover:bg-zinc-200 font-semibold px-6 py-3.5 rounded-lg text-sm transition-all duration-200 shadow-lg shadow-white/5 hover:scale-[1.02]">
          <i data-lucide="zap" class="w-4 h-4 text-orange-600"></i>
          <span>Get Started Free</span>
        </a>
        <a href="#mockup" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#161618] hover:bg-[#1E1E21] text-zinc-200 border border-[#27272A] hover:border-zinc-600 font-semibold px-6 py-3.5 rounded-lg text-sm transition-all duration-200">
          <i data-lucide="play" class="w-4 h-4 text-zinc-400"></i>
          <span>Live Interactive Demo</span>
        </a>
      </div>

      <!-- Hero Interactive Showcase Mockup -->
      <div id="mockup" class="relative max-w-5xl mx-auto rounded-2xl glass-card p-2 sm:p-4 text-left overflow-hidden border border-brand-border">
        
        <!-- Window Topbar -->
        <div class="flex items-center justify-between px-3 py-2 border-b border-brand-border mb-3 bg-[#111113] rounded-t-xl">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
            <span class="ml-2 text-xs font-mono text-zinc-500">workspace / doearly-core / tasks</span>
          </div>
          <div class="flex items-center gap-3 text-xs text-zinc-400">
            <span class="hidden sm:inline-flex items-center gap-1 bg-zinc-800/80 border border-zinc-700 px-2 py-0.5 rounded font-mono text-[11px]">
              <i data-lucide="command" class="w-3 h-3"></i> K for AI Command
            </span>
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="text-zinc-400 text-[11px]">Rails 8 Active</span>
          </div>
        </div>

        <!-- Dashboard Layout Mockup -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-3 min-h-[440px] bg-[#0E0E10] rounded-xl p-3 sm:p-4 border border-zinc-800/60 font-sans">
          
          <!-- Sidebar -->
          <div class="hidden md:flex md:col-span-3 flex-col justify-between border-r border-zinc-800/80 pr-3">
            <div class="space-y-4">
              <div class="flex items-center justify-between px-2 py-1.5 bg-zinc-900 rounded-lg border border-zinc-800">
                <span class="text-xs font-semibold text-zinc-300">⚡ Sprint 48 AI</span>
                <span class="text-[10px] bg-orange-500/20 text-orange-400 border border-orange-500/30 px-1.5 py-0.5 rounded">Running</span>
              </div>
              
              <div class="space-y-1 text-xs text-zinc-400">
                <a href="javascript:void(0)" class="flex items-center gap-2 px-2 py-1.5 rounded-md bg-zinc-800 text-white font-medium">
                  <i data-lucide="inbox" class="w-3.5 h-3.5 text-orange-400"></i> All Tasks
                  <span class="ml-auto text-[10px] bg-zinc-700 px-1.5 py-0.2 rounded font-mono"><%= @tasks.present? ? @tasks.count : 4 %></span>
                </a>
                <a href="javascript:void(0)" class="flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-zinc-800/50 hover:text-zinc-200 transition-colors">
                  <i data-lucide="sparkles" class="w-3.5 h-3.5 text-zinc-400"></i> AI Generated
                  <span class="ml-auto text-[10px] text-zinc-500 font-mono">3</span>
                </a>
                <a href="javascript:void(0)" class="flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-zinc-800/50 hover:text-zinc-200 transition-colors">
                  <i data-lucide="calendar" class="w-3.5 h-3.5 text-zinc-400"></i> High Priority
                  <span class="ml-auto text-[10px] text-red-400 font-mono">2</span>
                </a>
                <a href="javascript:void(0)" class="flex items-center gap-2 px-2 py-1.5 rounded-md hover:bg-zinc-800/50 hover:text-zinc-200 transition-colors">
                  <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-zinc-400"></i> Completed
                  <span class="ml-auto text-[10px] text-emerald-400 font-mono"><%= @tasks.present? ? @tasks.where(completed: true).count : 2 %></span>
                </a>
              </div>
            </div>

            <!-- Side user widget -->
            <div class="pt-4 border-t border-zinc-800/80 flex items-center gap-2 px-2 text-xs">
              <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-orange-500 to-amber-300 text-black font-bold flex items-center justify-center text-[10px]">
                K
              </div>
              <div class="flex flex-col">
                <span class="font-medium text-zinc-300 text-[11px]">Khaotai (Lead)</span>
                <span class="text-[9px] text-zinc-500">Pro Workspace</span>
              </div>
            </div>
          </div>

          <!-- Main Table View -->
          <div class="col-span-12 md:col-span-9 flex flex-col justify-between pl-0 md:pl-2 relative">
            
            <!-- Table Action Toolbar -->
            <div class="flex items-center justify-between pb-3 border-b border-zinc-800/80 gap-2 flex-wrap">
              <div class="flex items-center gap-2">
                <span class="text-sm font-bold text-white">Active Queue</span>
                <span class="text-xs text-zinc-500 font-mono">(Live Active Record Stream)</span>
              </div>
              <div class="flex items-center gap-2">
                <button class="text-xs bg-zinc-800 hover:bg-zinc-700 text-zinc-300 px-2.5 py-1 rounded-md border border-zinc-700 transition-colors flex items-center gap-1.5">
                  <i data-lucide="filter" class="w-3 h-3"></i> Filter
                </button>
                <button class="text-xs bg-orange-600 hover:bg-orange-500 text-white px-3 py-1 rounded-md font-medium transition-colors flex items-center gap-1 shadow-sm shadow-orange-500/20">
                  <i data-lucide="plus" class="w-3 h-3"></i> New Task
                </button>
              </div>
            </div>

            <!-- Dynamic or Seeded Task Rows -->
            <div class="space-y-2 py-3">
              
              <% if @tasks.present? && @tasks.any? %>
                <% @tasks.each_with_index do |task, idx| %>
                  <div class="flex items-center justify-between p-2.5 rounded-lg bg-zinc-900/90 border border-zinc-800 hover:border-zinc-700 transition-all text-xs">
                    <div class="flex items-center gap-2.5 flex-1 min-w-0">
                      <input type="checkbox" <%= 'checked' if task.completed? %> class="w-3.5 h-3.5 accent-orange-500 rounded bg-zinc-800 border-zinc-700 cursor-pointer">
                      <span class="font-medium <%= task.completed? ? 'text-zinc-400 line-through' : 'text-zinc-200' %> truncate">
                        <%= task.title %>
                      </span>
                    </div>
                    <div class="flex items-center gap-2 font-mono text-[11px]">
                      <% if task.completed? %>
                        <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px]">DONE</span>
                      <% else %>
                        <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[10px]">ACTIVE</span>
                      <% end %>
                      <span class="text-zinc-500 hidden sm:inline">#<%= task.id %></span>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <!-- Fallback Visual Rows -->
                <div class="flex items-center justify-between p-2.5 rounded-lg bg-zinc-900/90 border border-zinc-800 hover:border-zinc-700 transition-all text-xs">
                  <div class="flex items-center gap-2.5 flex-1 min-w-0">
                    <input type="checkbox" checked class="w-3.5 h-3.5 accent-orange-500 rounded bg-zinc-800 border-zinc-700 cursor-pointer">
                    <span class="font-medium text-zinc-400 line-through truncate">Implement Rails 8.1 MVC Architecture Core</span>
                  </div>
                  <div class="flex items-center gap-2 font-mono text-[11px]">
                    <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px]">DONE</span>
                    <span class="text-zinc-500 hidden sm:inline">@Khao</span>
                  </div>
                </div>

                <div class="flex items-center justify-between p-2.5 rounded-lg bg-zinc-900/90 border border-zinc-800 hover:border-zinc-700 transition-all text-xs">
                  <div class="flex items-center gap-2.5 flex-1 min-w-0">
                    <input type="checkbox" class="w-3.5 h-3.5 accent-orange-500 rounded bg-zinc-800 border-zinc-700 cursor-pointer">
                    <span class="font-medium text-zinc-200 truncate">Configure Active Record Validations & Schema</span>
                  </div>
                  <div class="flex items-center gap-2 font-mono text-[11px]">
                    <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[10px]">MEDIUM</span>
                    <span class="text-zinc-400 hidden sm:inline">@Design</span>
                  </div>
                </div>
              <% end %>

              <!-- Floating AI Suggestion Bar -->
              <div class="relative flex items-center justify-between p-2.5 rounded-lg bg-zinc-900 border border-orange-500/40 shadow-lg shadow-orange-500/5 text-xs">
                <div class="flex items-center gap-2.5 flex-1 min-w-0">
                  <input type="checkbox" class="w-3.5 h-3.5 accent-orange-500 rounded bg-zinc-800 border-zinc-700 cursor-pointer">
                  <span class="font-semibold text-white truncate">Setup RESTful CRUD Routes & Strong Parameters</span>
                </div>
                <div class="flex items-center gap-2 font-mono text-[11px]">
                  <span class="px-2 py-0.5 rounded bg-rose-500/15 text-rose-400 border border-rose-500/30 text-[10px] animate-pulse">URGENT</span>
                  <span class="text-orange-400 font-semibold hidden sm:inline">AI Suggested</span>
                </div>

                <!-- Active Floating AI Dropdown Menu -->
                <div class="absolute -bottom-24 right-4 sm:right-10 z-30 w-72 p-3 rounded-xl bg-[#18181B] border border-orange-500/40 shadow-2xl text-left backdrop-blur-md">
                  <div class="flex items-center justify-between text-[11px] text-orange-400 font-bold mb-1">
                    <span class="flex items-center gap-1"><i data-lucide="sparkles" class="w-3 h-3"></i> AI Smart Recommendation</span>
                    <span class="text-zinc-500">Just now</span>
                  </div>
                  <p class="text-[11px] text-zinc-300 leading-snug">
                    "Auto-generate controller specs & verify route constraints for <code>tasks#index</code>?"
                  </p>
                  <div class="mt-2 flex items-center gap-2">
                    <button class="bg-orange-500 hover:bg-orange-600 text-white text-[10px] font-bold px-2 py-1 rounded transition-colors">
                      Accept & Run
                    </button>
                    <button class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-[10px] px-2 py-1 rounded transition-colors">
                      Dismiss
                    </button>
                  </div>
                </div>
              </div>

            </div>

            <!-- Footer info in mockup -->
            <div class="pt-8 sm:pt-4 flex items-center justify-between text-[11px] text-zinc-500 font-mono">
              <span>Syncing with SQLite Engine • 12ms latency</span>
              <span>⚡ Doearly Core Agent v2.4</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Social Proof (Logo Cloud) -->
    <section class="py-12 border-y border-brand-border/60 bg-[#0E0E10]/50">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <p class="text-xs uppercase font-mono tracking-widest text-brand-muted mb-8 font-semibold">
          Trusted by 10,000+ high-velocity engineering & product teams worldwide
        </p>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-8 items-center justify-center opacity-60 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300">
          <div class="flex items-center justify-center gap-1.5 font-bold text-zinc-400 hover:text-white">
            <i data-lucide="slack" class="w-5 h-5"></i> Slack
          </div>
          <div class="flex items-center justify-center gap-1.5 font-bold text-zinc-400 hover:text-white">
            <i data-lucide="figma" class="w-5 h-5"></i> Figma
          </div>
          <div class="flex items-center justify-center gap-1.5 font-bold text-zinc-400 hover:text-white">
            <i data-lucide="credit-card" class="w-5 h-5"></i> Stripe
          </div>
          <div class="flex items-center justify-center gap-1.5 font-bold text-zinc-400 hover:text-white">
            <i data-lucide="trello" class="w-5 h-5"></i> Monday.com
          </div>
          <div class="flex items-center justify-center gap-1.5 font-bold text-zinc-400 hover:text-white">
            <i data-lucide="globe" class="w-5 h-5"></i> Google
          </div>
          <div class="flex items-center justify-center gap-1.5 font-bold text-zinc-400 hover:text-white">
            <i data-lucide="box" class="w-5 h-5"></i> Microsoft
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Feature Grid (Bento Grid Style) -->
    <section id="bento" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-mono font-bold uppercase text-brand-accent tracking-wider bg-orange-500/10 px-3 py-1 rounded-full border border-orange-500/20">
          Bento Workspace
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tighter mt-4 mb-4">
          Everything In One Workspace
        </h2>
        <p class="text-brand-muted text-base sm:text-lg">
          Purpose-built primitives designed to eliminate context switching and streamline development velocity.
        </p>
      </div>

      <!-- 2x2 Bento Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Card 1: Task List with Status Dots -->
        <div class="glass-card rounded-2xl p-7 flex flex-col justify-between group">
          <div>
            <div class="w-10 h-10 rounded-xl bg-orange-500/10 text-orange-400 border border-orange-500/20 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
              <i data-lucide="list-todo" class="w-5 h-5"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Dynamic Status Engine</h3>
            <p class="text-brand-muted text-sm leading-relaxed mb-6">
              Track multi-stage workflows with responsive status indicators, subtask rollups, and auto-completion triggers.
            </p>
          </div>

          <div class="bg-[#0B0B0C] rounded-xl p-4 border border-zinc-800/80 space-y-2.5 font-mono text-xs">
            <div class="flex items-center justify-between p-2 rounded bg-zinc-900/60 border border-zinc-800">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-sm shadow-emerald-400/50"></span>
                <span class="text-zinc-200">Database Index Optimization</span>
              </div>
              <span class="text-[10px] text-emerald-400">COMPLETED</span>
            </div>
            <div class="flex items-center justify-between p-2 rounded bg-zinc-900/60 border border-zinc-800">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400 shadow-sm shadow-amber-400/50"></span>
                <span class="text-zinc-200">Authentication Middleware Setup</span>
              </div>
              <span class="text-[10px] text-amber-400">IN PROGRESS</span>
            </div>
            <div class="flex items-center justify-between p-2 rounded bg-zinc-900/60 border border-zinc-800">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500 shadow-sm shadow-rose-500/50"></span>
                <span class="text-zinc-200">Payment Webhook Verification</span>
              </div>
              <span class="text-[10px] text-rose-400">BLOCKED</span>
            </div>
          </div>
        </div>

        <!-- Card 2: Categorization & Priority Filtering -->
        <div class="glass-card rounded-2xl p-7 flex flex-col justify-between group">
          <div>
            <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-400 border border-blue-500/20 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
              <i data-lucide="sliders-horizontal" class="w-5 h-5"></i>
            </div>
