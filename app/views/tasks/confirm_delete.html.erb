<%# ⚡ TURBO FRAME: Delete Confirmation Modal & UI %>
<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md animate-fadeIn">
    <div class="glass-card w-full max-w-md rounded-2xl border border-red-500/30 p-6 shadow-2xl bg-[#141416] space-y-5 animate-toast text-left">
      
      <!-- Modal Header -->
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-xl bg-red-500/10 text-red-400 border border-red-500/25 flex items-center justify-center shrink-0 shadow-lg shadow-red-500/10">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 6h18"/>
            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
            <line x1="10" x2="10" y1="11" y2="17"/>
            <line x1="14" x2="14" y1="11" y2="17"/>
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-lg font-bold text-white leading-tight">Delete Task Confirmation</h3>
          <p class="text-xs text-zinc-400 mt-1">Are you sure you want to permanently remove this record from SQLite database?</p>
        </div>
      </div>

      <!-- Task Details Box -->
      <div class="p-3.5 rounded-xl bg-[#0B0B0C] border border-zinc-800 space-y-2 text-xs">
        <div class="flex items-center justify-between text-zinc-400 font-mono text-[11px]">
          <span>Task ID: <strong>#<%= @task.id %></strong></span>
          <span><%= @task.completed? ? '✅ Status: DONE' : '⏳ Status: ACTIVE' %></span>
        </div>
        <div class="font-semibold text-white text-sm break-words bg-zinc-900/90 p-3 rounded-lg border border-zinc-800/80">
          "<%= @task.title %>"
        </div>
        <div class="text-[11px] text-zinc-500 font-mono">
          Created: <%= @task.created_at.strftime("%b %d, %Y at %I:%M %p") %>
        </div>
      </div>

      <!-- Warning Callout & Keyboard Shortcut Hint -->
      <div class="flex items-center justify-between gap-2.5 p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-300 text-[11px]">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <span>Press <kbd class="px-1.5 py-0.5 rounded bg-zinc-800 border border-zinc-700 text-white font-mono text-[10px]">Enter</kbd> to delete</span>
        </div>
        <span class="text-zinc-500 text-[10px]"><kbd class="px-1 py-0.5 rounded bg-zinc-800 text-zinc-400 font-mono text-[10px]">Esc</kbd> to cancel</span>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center justify-end gap-3 pt-2">
        <%= link_to "Cancel", root_path, id: "cancel-modal-btn", data: { turbo_frame: "modal" }, class: "px-4 py-2.5 rounded-xl text-xs font-semibold text-zinc-300 hover:text-white bg-zinc-800 hover:bg-zinc-700 transition-colors cursor-pointer" %>
        
        <%= button_to task_path(@task), 
                      method: :delete, 
                      id: "confirm-delete-btn",
                      autofocus: true,
                      class: "px-4 py-2.5 rounded-xl text-xs font-semibold text-white bg-red-600 hover:bg-red-500 focus:ring-2 focus:ring-red-400 focus:outline-none shadow-lg shadow-red-600/30 transition-all cursor-pointer flex items-center gap-1.5 border-0" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
          <span>Confirm & Delete</span>
        <% end %>
      </div>

    </div>
  </div>

  <script>
    (function() {
      // Auto-focus delete button immediately
      const delBtn = document.getElementById('confirm-delete-btn');
      if (delBtn) delBtn.focus();

      // Listen for Enter & Escape keys
      const onKeyDown = function(e) {
        if (e.key === 'Escape') {
          const cancelBtn = document.getElementById('cancel-modal-btn');
          if (cancelBtn) cancelBtn.click();
          document.removeEventListener('keydown', onKeyDown);
        }
      };
      document.addEventListener('keydown', onKeyDown);
    })();
  </script>
<% end %>
