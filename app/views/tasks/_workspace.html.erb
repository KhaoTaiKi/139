<!-- Main Workspace Container -->
<div class="relative rounded-2xl glass-card p-4 sm:p-6 text-left overflow-hidden border border-brand-border shadow-2xl">
  
  <!-- Window Topbar -->
  <div class="flex items-center justify-between px-3 py-2.5 border-b border-brand-border mb-4 bg-[#111113] rounded-xl">
    <div class="flex items-center gap-2">
      <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
      <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
      <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
      <span class="ml-2 text-xs font-mono text-zinc-500">workspace / tasks / active_record</span>
    </div>
    <div class="flex items-center gap-3 text-xs text-zinc-400">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="text-zinc-400 text-[11px] font-mono">SQLite3 Connected • Rails 8.1</span>
    </div>
  </div>

  <!-- Dashboard Layout Grid -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-4 min-h-[420px] bg-[#0E0E10] rounded-xl p-3 sm:p-5 border border-zinc-800/60 font-sans">
    
    <!-- Sidebar Navigation -->
    <div class="hidden md:flex md:col-span-3 flex-col justify-between border-r border-zinc-800/80 pr-4">
      <div class="space-y-4">
        <div class="flex items-center justify-between px-2.5 py-1.5 bg-zinc-900 rounded-lg border border-zinc-800">
          <span class="text-xs font-semibold text-zinc-300">⚡ Tasks Manager</span>
          <span class="text-[10px] bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-1.5 py-0.5 rounded font-mono">Live</span>
        </div>
        
        <!-- Task Counters (Turbo Frame Partial) -->
        <%= render "tasks/task_counters" %>
      </div>

      <!-- Workspace User Status -->
      <div class="pt-4 border-t border-zinc-800/80 flex items-center gap-2 px-2 text-xs">
        <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-orange-500 to-amber-300 text-black font-bold flex items-center justify-center text-[10px]">
          K
        </div>
        <div class="flex flex-col">
          <span class="font-medium text-zinc-300 text-[11px]">Khaotai (Lead)</span>
          <span class="text-[9px] text-zinc-500">Active Workspace</span>
        </div>
      </div>
    </div>

    <!-- Main Table View -->
    <div class="col-span-12 md:col-span-9 flex flex-col justify-between pl-0 md:pl-2 relative">
      
      <!-- Real-Time Flash & Toast Feedback Container -->
      <div id="flash_toast_container"></div>

      <!-- Table Action Toolbar -->
      <div class="flex items-center justify-between pb-3 border-b border-zinc-800/80 gap-2 flex-wrap">
        <div class="flex items-center gap-2">
          <span class="text-sm font-bold text-white">Active Queue</span>
          <span class="text-xs text-zinc-500 font-mono">(Turbo Stream Real-Time CRUD)</span>
        </div>
        <div class="flex items-center gap-2">
          <%= link_to new_task_path, 
                      data: { turbo_frame: "new_task_form_container" }, 
                      class: "text-xs bg-orange-600 hover:bg-orange-500 text-white px-3 py-1.5 rounded-md font-medium transition-colors flex items-center gap-1 shadow-sm shadow-orange-500/20 cursor-pointer" do %>
            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
            <span>New Task</span>
          <% end %>
        </div>
      </div>

      <!-- Inline New Task Form Target (Turbo Frame) -->
      <%= turbo_frame_tag "new_task_form_container" do %>
      <% end %>

      <!-- Task List Partial (Turbo Frame) -->
      <%= render "tasks/task_list" %>

      <!-- Footer Info Bar -->
      <div class="pt-6 sm:pt-4 flex items-center justify-between text-[11px] text-zinc-500 font-mono border-t border-zinc-800/60 mt-4">
        <span>Active Record Engine • Turbo Frame & Turbo Stream</span>
        <span>⚡ SQLite3</span>
      </div>
    </div>
  </div>
</div>
