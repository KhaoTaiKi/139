<%# ⚡ TURBO FRAME: Individual Task Row (dom_id(task)) %>
<%= turbo_frame_tag dom_id(task) do %>
  <div class="flex items-center justify-between p-2.5 rounded-lg bg-zinc-900/90 border border-zinc-800 hover:border-zinc-700 transition-all text-xs group">
    
    <!-- Checkbox & Title Toggle (Clickable whole area) -->
    <div class="flex-1 min-w-0 pr-2">
      <%= button_to toggle_task_path(task), 
                    method: :patch, 
                    form_class: "w-full m-0 p-0", 
                    class: "w-full flex items-center gap-2.5 text-left bg-transparent border-0 p-0 cursor-pointer" do %>
        <input type="checkbox" 
               <%= 'checked' if task.completed? %> 
               class="w-3.5 h-3.5 accent-orange-500 rounded bg-zinc-800 border-zinc-700 cursor-pointer pointer-events-none shrink-0">
        <span class="font-medium <%= task.completed? ? 'text-zinc-500 line-through' : 'text-zinc-200' %> truncate pointer-events-none">
          <%= task.title %>
        </span>
      <% end %>
    </div>

    <!-- Status Badge, Delete Button & ID -->
    <div class="flex items-center gap-2 font-mono text-[11px] shrink-0">
      <% if task.completed? %>
        <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px]">DONE</span>
      <% else %>
        <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[10px]">ACTIVE</span>
      <% end %>

      <!-- Delete Button Linking to Delete Confirmation UI Modal -->
      <%= link_to confirm_delete_task_path(task), 
                  data: { turbo_frame: "modal" },
                  class: "opacity-70 group-hover:opacity-100 text-zinc-400 hover:text-red-400 hover:bg-red-500/10 p-1.5 rounded transition-all flex items-center justify-center cursor-pointer" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 6h18"/>
          <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
          <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
          <line x1="10" x2="10" y1="11" y2="17"/>
          <line x1="14" x2="14" y1="11" y2="17"/>
        </svg>
      <% end %>

      <span class="text-zinc-500 hidden sm:inline">#<%= task.id %></span>
    </div>
  </div>
<% end %>
